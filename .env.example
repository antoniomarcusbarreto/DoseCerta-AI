# Copie para .env.local e preencha com as chaves do seu projeto Firebase.
# (Console do Firebase > Configurações do projeto > Seus apps > Configuração do SDK)
#
# Estas chaves são públicas por natureza — o que protege os dados são as
# firestore.rules, não o segredo destas variáveis.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Chave pública do Web Push (Console > Cloud Messaging > Certificados push da Web).
# Só necessária na Fase 5, quando os lembretes entrarem.
VITE_FIREBASE_VAPID_KEY=

# URL da Cloud Function chatCopiloto (onRequest, não onCall — por isso precisa
# da URL completa). Formato: https://<região>-<project-id>.cloudfunctions.net/chatCopiloto
# Para o emulador local: http://127.0.0.1:5001/<project-id>/southamerica-east1/chatCopiloto
VITE_CHAT_COPILOTO_URL=

# Chave PUBLICA do par VAPID (npx web-push generate-vapid-keys).
# A privada vai para o secret VAPID_PRIVATE_KEY das Cloud Functions.
VITE_VAPID_PUBLIC_KEY=<valor>
