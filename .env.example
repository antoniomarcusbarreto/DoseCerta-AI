# Copie para .env.local e preencha com as chaves do seu projeto Firebase.
# (Console do Firebase > Configurações do projeto > Seus apps > Configuração do SDK)
#
# Estas chaves são públicas por natureza — o que protege os dados são as
# firestore.rules, não o segredo destas variáveis.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Chave pública do Web Push (Console > Cloud Messaging > Certificados push da Web).
# Só necessária na Fase 5, quando os lembretes entrarem.
VITE_FIREBASE_VAPID_KEY=
