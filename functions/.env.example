# Copie para functions/.env e ajuste se quiser trocar o modelo sem editar código.
# GEMINI_API_KEY e RESEND_API_KEY NÃO vão aqui — são secrets
# (`firebase functions:secrets:set GEMINI_API_KEY` / `RESEND_API_KEY`),
# nunca um valor em texto plano num arquivo .env.

GEMINI_MODEL=gemini-flash-latest

# rpID do WebAuthn/Passkeys — precisa bater exatamente com o domínio de produção.
WEBAUTHN_RP_ID=dosecerta-ai.com
