# Copie para functions/.env e ajuste se quiser trocar o modelo sem editar código.
# GEMINI_API_KEY e RESEND_API_KEY NÃO vão aqui — são secrets
# (`firebase functions:secrets:set GEMINI_API_KEY` / `RESEND_API_KEY`),
# nunca um valor em texto plano num arquivo .env.

GEMINI_MODEL=gemini-flash-latest

# rpID do WebAuthn/Passkeys. Fica no apex mesmo com o site em www: basta ser um
# sufixo registrável da origem abaixo. No emulador: localhost
WEBAUTHN_RP_ID=dosecerta-ai.com

# Origem EXATA servida em produção (o WebAuthn não tolera divergência, e o apex
# responde 308 para o www). No emulador: http://localhost:5173
WEBAUTHN_ORIGIN=https://www.dosecerta-ai.com
